# =============================================================================
# Esquema de variables de entorno de DOAPP (formato Varlock: https://varlock.dev)
#
# Declara QUÉ variables existen, de qué tipo son y cuáles son secretas. NO contiene
# ningún valor real: se puede leer, versionar y mostrar sin riesgo. Los valores van en
# .env (ignorado por git) o en las variables del servidor.
#
# Regla de oro: si una variable nueva aparece en el código y no está acá, el test
# tests/entornoEsquema.test.ts falla. Así nadie se entera de que debía configurar un secreto
# recién cuando algo deja de protegerse en producción.
#
# Anotaciones: @sensitive = secreta (nunca se imprime) · @sensitive=false = pública
#              @required  = obligatoria · @type=… = formato esperado
# =============================================================================
# @defaultSensitive=true @defaultRequired=false

# -----------------------------------------------------------------------------
# Aplicación y entorno
# -----------------------------------------------------------------------------
# @type=enum(development,test,staging,production) @sensitive=false
APP_ENV=
# @type=url @sensitive=false
APP_URL=
# @type=url @required @sensitive=false
CLIENT_URL=
# Hoy el código no la lee (ver informe de seguridad): se documenta pero no hace nada.
# @type=string @sensitive=false
COOKIE_SAME_SITE=
# Hoy el código no la lee (ver informe de seguridad): se documenta pero no hace nada.
# @type=boolean @sensitive=false
COOKIE_SECURE=
# @type=string @sensitive=false
CORS_ORIGIN=
# @type=string @sensitive=false
CORS_ORIGINS=
# @type=number @sensitive=false
KYC_MAX_ATTEMPTS=
# @type=string @sensitive=false
LOG_FORMAT=
# @type=string @sensitive=false
LOG_LEVEL=
# @type=number @sensitive=false
MAX_FILE_SIZE=
# En producción debe ser "production": activa las barreras (cookies Secure, firma obligatoria de webhooks).
# @type=enum(development,test,staging,production) @required @sensitive=false
NODE_ENV=
# @type=port @required @sensitive=false
PORT=
# @type=string @sensitive=false
POST_WORK_RATING_SINCE=
# Hoy el código no la lee: los límites están escritos en el código.
# @type=number @sensitive=false
RATE_LIMIT_MAX_REQUESTS=
# Hoy el código no la lee: los límites están escritos en el código.
# @type=number @sensitive=false
RATE_LIMIT_WINDOW_MS=
# @type=email @sensitive=false
SECURITY_CONTACT_EMAIL=
# @type=url @sensitive=false
SERVER_URL=
# @type=string @sensitive=false
SERVICE_NAME=
# @type=email @sensitive=false
SUPPORT_EMAIL=
# @type=string @sensitive=false
UPLOAD_DIR=

# -----------------------------------------------------------------------------
# Base de datos y Redis
# -----------------------------------------------------------------------------
# @type=url @sensitive
DATABASE_URL=
# @type=string @required @sensitive=false
DB_HOST=
# @type=string @required @sensitive=false
DB_NAME=
# @type=string @required @sensitive
DB_PASSWORD=
# @type=number @sensitive=false
DB_POOL_ACQUIRE=
# @type=number @sensitive=false
DB_POOL_IDLE=
# @type=number @sensitive=false
DB_POOL_MAX=
# @type=number @sensitive=false
DB_POOL_MIN=
# @type=port @sensitive=false
DB_PORT=
# @type=boolean @sensitive=false
DB_SSL=
# @type=string @required @sensitive=false
DB_USER=
# @type=url @sensitive
DEV_DATABASE_URL=
# @type=url @sensitive
REDIS_URL=
# @type=url @sensitive
TEST_DATABASE_URL=

# -----------------------------------------------------------------------------
# Sesión, tokens y cifrado
# -----------------------------------------------------------------------------
# Cifra datos en reposo. En producción NO puede quedar vacía (el código tiene un valor de respaldo inseguro).
# @type=string @required @sensitive
ENCRYPTION_KEY=
# @type=string @sensitive=false
JWT_EXPIRE=
# @type=string @sensitive=false
JWT_EXPIRES_IN=
# @type=string @sensitive=false
JWT_REFRESH_EXPIRES_IN=
# Firma las sesiones. Cambiarla cierra todas las sesiones abiertas. Mínimo 32 caracteres aleatorios.
# @type=string @required @sensitive
JWT_SECRET=
# Hash bcrypt de la contraseña extra del rol admin. Nunca la contraseña en claro.
# @type=string @sensitive
ROLE_PASSWORD_ADMIN=
# Hash bcrypt de la contraseña de emergencia. Nunca la contraseña en claro.
# @type=string @sensitive
ROLE_PASSWORD_EMERGENCY=
# Hash bcrypt de la contraseña extra del rol owner. Nunca la contraseña en claro.
# @type=string @sensitive
ROLE_PASSWORD_OWNER=
# Hoy el código no la lee: se documenta pero no hace nada.
# @type=string @sensitive
SESSION_SECRET=

# -----------------------------------------------------------------------------
# MercadoPago
# -----------------------------------------------------------------------------
# APP_USR-… en producción; TEST-… sólo con tarjetas de prueba. No mezclar.
# @type=string @required @sensitive
MERCADOPAGO_ACCESS_TOKEN=
# @type=string @sensitive
MERCADOPAGO_ACCESS_TOKEN_TEST=
# @type=string @sensitive=false
MERCADOPAGO_CLIENT_ID=
# @type=string @sensitive
MERCADOPAGO_CLIENT_SECRET=
# @type=url @sensitive=false
MERCADOPAGO_OAUTH_REDIRECT_URI=
# @type=string @sensitive=false
MERCADOPAGO_PUBLIC_KEY=
# @type=string @sensitive=false
MERCADOPAGO_PUBLIC_KEY_TEST=
# @type=boolean @sensitive=false
MERCADOPAGO_SPLIT_PAYMENTS_ENABLED=
# Firma de los avisos de MercadoPago. Sin ella, cualquiera podría avisar "pago aprobado". Se saca del panel de MP (Webhooks).
# @type=string @required @sensitive
MERCADOPAGO_WEBHOOK_SECRET=
# Apagada por defecto. En true, el webhook de MercadoPago procesa los pagos de CONTRATO (escrow), de COTIZACIÓN y las órdenes al terminar (quedan en revisión de un admin). Las publicaciones, membresías y aumentos de presupuesto los sigue confirmando capture-order. Ver webhooks.ts.
# @type=boolean @sensitive=false
MP_WEBHOOK_PROCESA_PAGOS=
# @type=number @sensitive=false
PAYMENT_PROCESSING_FEE_RATE=
# @type=number @sensitive=false
PAYMENT_RELEASE_DAYS=

